# Copy to `.env` (gitignored). The ONE allowed real secret is the LLM provider key.
# Everything else in this system is mocked or uses obviously-fake sandbox values.

# --- The one allowed real secret (read from env at runtime, NEVER committed) ---
ANTHROPIC_API_KEY=

# --- Obviously-fake, disposable, sandbox-only values for the MOCK services ---
# These are placeholders for the mocked tool layer. They are not real and lead nowhere.
# If you ever paste a value here that looks like a real key, the CI secret guard will fail.
MOCK_EMAIL_ENDPOINT=http://localhost:8099/mock/email
MOCK_SCHEDULER_ENDPOINT=http://localhost:8099/mock/scheduler
MOCK_SEARCH_ENDPOINT=http://localhost:8099/mock/search

# Shared tool-layer service token (naive single shared token, on purpose).
# Obviously-fake sandbox value. No runtime code path consumes this token — it is a
# configuration-surface artifact, not a reachable runtime credential.
TOOL_LAYER_TOKEN=fake-sandbox-tool-token-do-not-use-anywhere-real
